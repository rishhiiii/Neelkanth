{
  "name": "neelkanth-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Neelkanth Pharmacies — Ayurvedic medicines ecommerce",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npm install --include=dev --prefix ../client && npm run build --prefix ../client",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "import:catalogue": "node src/scripts/importCatalogue.js",
    "import:catalogue:run": "node src/scripts/importCatalogue.js --execute",
    "import:catalogue:run:no-images": "node src/scripts/importCatalogue.js --execute --skip-images"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1"
  }
}
