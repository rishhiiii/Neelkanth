# ─── Core ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/neelkanth

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend URLs)
# Use * to allow all origins (testing only — not for production)
CORS_ORIGINS=http://localhost:5173

# ─── Frontend URL (used in email links) ──────────────
FRONTEND_URL=http://localhost:5173

# ─── JWT (Module 2) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-customer-access-secret
JWT_REFRESH_SECRET=change-me-customer-refresh-secret
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret
# JWT_ACCESS_EXPIRES_IN=15m          # default: 15m
# JWT_REFRESH_EXPIRES_IN_DAYS=7      # default: 7

# ─── SMTP (Module 2) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SMTP_FROM=Neelkanth Global Wellness <noreply@ngwellness.in>

# ─── Cloudinary (Module 4) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Seller / GST (Module 8, 10) ─────────────────────
SELLER_STATE=Rajasthan
SELLER_GSTIN=your-gstin

# ─── PhonePe (Module 8) ─────────────────────────────
PHONEPE_MERCHANT_ID=your-merchant-id
PHONEPE_CLIENT_ID=your-client-id
PHONEPE_CLIENT_SECRET=your-client-secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
# PHONEPE_CALLBACK_URL=https://yourdomain.com/api/v1/orders/payment/callback
